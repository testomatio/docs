---
import TOCList from './TOCList.astro';

const { toc } = Astro.locals.starlightRoute;
---

{
	toc && (
		<starlight-toc data-min-h={toc.minHeadingLevel} data-max-h={toc.maxHeadingLevel}>
			<nav aria-labelledby="starlight__on-this-page">
				<h2 id="starlight__on-this-page">{Astro.locals.t('tableOfContents.onThisPage')}</h2>
				<div class="toc-list-wrapper">
					<div class="toc-indicator" aria-hidden="true"></div>
					<TOCList toc={toc.items} />
				</div>
			</nav>
		</starlight-toc>
	)
}

<script>
	// ── Starlight TOC scroll-spy (inlined from starlight-toc.ts) ──────────────
	const PAGE_TITLE_ID = '_top';

	class StarlightTOC extends HTMLElement {
		private _current = this.querySelector<HTMLAnchorElement>('a[aria-current="true"]');
		private minH = parseInt(this.dataset.minH || '2', 10);
		private maxH = parseInt(this.dataset.maxH || '3', 10);

		private tocHeadingSelector =
			`h1#${PAGE_TITLE_ID},` +
			`:where(${Array.from({ length: 1 + this.maxH - this.minH }, (_, i) => `h${this.minH + i}`).join()})[id]`;

		protected set current(link: HTMLAnchorElement) {
			if (link === this._current) return;
			if (this._current) this._current.removeAttribute('aria-current');
			link.setAttribute('aria-current', 'true');
			this._current = link;
		}

		private onIdle = (cb: IdleRequestCallback) =>
			(window.requestIdleCallback || ((cb: () => void) => setTimeout(cb, 1)))(cb);

		constructor() {
			super();
			this.onIdle(() => this.init());
		}

		private init = (): void => {
			const links = [...this.querySelectorAll('a')];

			const isHeading = (el: Element): el is HTMLHeadingElement =>
				el.matches(this.tocHeadingSelector);

			const getElementHeading = (el: Element | null): HTMLHeadingElement | null => {
				if (!el) return null;
				const origin = el;
				while (el) {
					if (el.matches('.sl-markdown-content, main > *')) {
						return document.getElementById(PAGE_TITLE_ID) as HTMLHeadingElement;
					}
					if (isHeading(el)) return el;
					const childHeading = el.querySelector<HTMLHeadingElement>(this.tocHeadingSelector);
					if (childHeading) return childHeading;
					el = el.previousElementSibling!;
					while (el?.lastElementChild) el = el.lastElementChild!;
					const h = getElementHeading(el);
					if (h) return h;
				}
				return getElementHeading(origin.parentElement);
			};

			const setCurrent: IntersectionObserverCallback = (entries) => {
				for (const { isIntersecting, target } of entries) {
					if (!isIntersecting) continue;
					const heading = getElementHeading(target);
					if (!heading) continue;
					const link = links.find((l) => l.hash === '#' + encodeURIComponent(heading.id));
					if (link) { this.current = link; break; }
				}
			};

			const toObserve = document.querySelectorAll(
				[
					`main :where(${this.tocHeadingSelector})`,
					`main :where(${this.tocHeadingSelector}, .sl-heading-wrapper) ~ *:not(:has(${this.tocHeadingSelector}))`,
					`main .sl-markdown-content > *:not(:has(${this.tocHeadingSelector}))`,
					`main > *:not(:has(${this.tocHeadingSelector}))`,
				].join()
			);

			let observer: IntersectionObserver | undefined;
			const observe = () => {
				if (observer) return;
				observer = new IntersectionObserver(setCurrent, { rootMargin: this.getRootMargin() });
				toObserve.forEach((h) => observer!.observe(h));
			};
			observe();

			let timeout: ReturnType<typeof setTimeout>;
			window.addEventListener('resize', () => {
				if (observer) { observer.disconnect(); observer = undefined; }
				clearTimeout(timeout);
				timeout = setTimeout(() => this.onIdle(observe), 200);
			});
		};

		private getRootMargin(): `-${number}px 0% ${number}px` {
			const navBarHeight = document.querySelector('header')?.getBoundingClientRect().height || 0;
			const mobileTocHeight = this.querySelector('summary')?.getBoundingClientRect().height || 0;
			const top = navBarHeight + mobileTocHeight + 32;
			const bottom = top + 53;
			const height = document.documentElement.clientHeight;
			return `-${top}px 0% ${bottom - height}px`;
		}
	}

	if (!customElements.get('starlight-toc')) {
		customElements.define('starlight-toc', StarlightTOC);
	}

	// ── Snake indicator ───────────────────────────────────────────────────────
	let snakeObserver: MutationObserver | null = null;

	function initSnakeTOC() {
		// Clean up previous observer on page navigation
		if (snakeObserver) {
			snakeObserver.disconnect();
			snakeObserver = null;
		}

		const wrapper = document.querySelector<HTMLElement>('starlight-toc .toc-list-wrapper');
		if (!wrapper) return;
		const indicator = wrapper.querySelector<HTMLElement>('.toc-indicator');
		if (!indicator) return;

		function moveIndicator(link: HTMLAnchorElement, instant = false) {
			const wrapperTop = wrapper!.getBoundingClientRect().top;
			const linkRect = link.getBoundingClientRect();
			if (instant) indicator!.style.transition = 'none';
			indicator!.style.transform = `translateY(${linkRect.top - wrapperTop}px)`;
			indicator!.style.height = `${linkRect.height}px`;
			indicator!.style.opacity = '1';
			if (instant) {
				// Force reflow so the position is applied before re-enabling transition
				indicator!.offsetHeight;
				indicator!.style.transition = '';
			}
		}

		let isFirstSync = true;
		function syncIndicator() {
			const active = wrapper!.querySelector<HTMLAnchorElement>('a[aria-current="true"]');
			if (active) {
				moveIndicator(active, isFirstSync);
				isFirstSync = false;
			}
		}

		const list = wrapper.querySelector('ul');
		if (list) {
			snakeObserver = new MutationObserver(syncIndicator);
			snakeObserver.observe(list, {
				attributes: true,
				attributeFilter: ['aria-current'],
				subtree: true,
			});
		}

		// Wait for Starlight's own idle-callback init before syncing
		const onIdle = window.requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 50));
		onIdle(syncIndicator);
	}

	document.addEventListener('astro:page-load', initSnakeTOC);
	// Fallback for non-SPA environments
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initSnakeTOC);
	} else {
		initSnakeTOC();
	}
</script>

<style>
	.toc-list-wrapper {
		position: relative;
	}

	.toc-indicator {
		position: absolute;
		left: 0;
		width: 2px;
		height: 1.75rem;
		background-color: var(--sl-color-text-accent);
		border-radius: 1px;
		opacity: 0;
		transition:
			transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94),
			height 0.2s ease,
			opacity 0.2s ease;
		pointer-events: none;
	}
</style>
