---
interface TocItem {
	slug: string;
	text: string;
	children: TocItem[];
}

interface Props {
	toc: TocItem[];
	depth?: number;
}

const { toc, depth = 0 } = Astro.props;
---

<ul>
	{
		toc.map((heading) => (
			<li>
				<a
					href={'#' + heading.slug}
					style={`padding-inline: calc(1rem * ${depth} + 0.5rem) 0.5rem`}
				>
					<span>{heading.text}</span>
				</a>
				{heading.children.length > 0 && (
					<Astro.self toc={heading.children} depth={depth + 1} />
				)}
			</li>
		))
	}
</ul>

<style>
	ul {
		padding: 0;
		list-style: none;
	}
	a {
		display: block;
		border-radius: 0.25rem;
		padding-block: 0.25rem;
		line-height: 1.25;
	}
	a[aria-current='true'] {
		color: var(--sl-color-text-accent);
	}
</style>
